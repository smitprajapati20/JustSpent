<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/_7sdp"
    tools:context=".Dashboard">

        <LinearLayout
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background = "@drawable/bg_logo_badge"
                android:src="@drawable/ic_wallet"
                android:padding="@dimen/_5sdp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dashboard"
                android:textSize="@dimen/_24sdp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:gravity="center" />

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:src="@drawable/ic_person_user"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="@dimen/_6sdp"
                android:background="@drawable/bg_logo_badge" />

        </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_income_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_up" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Income"
                    android:textColor="@color/button_text"
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtTotalIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="₹0"
                    android:textColor="@color/button_text"
                    android:textSize="@dimen/_18sdp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_expense_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_down" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Expense"
                    android:textColor="@color/button_text"
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtTotalExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:text="₹0"
                    android:textColor="@color/button_text"
                    android:textSize="@dimen/_18sdp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:padding="0dp"
                android:id="@+id/recents"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_primary_button"
                app:backgroundTint="@null"
                android:text="Recents"
                android:layout_marginEnd="@dimen/_7sdp"
                android:textColor="@color/button_text"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"/>

            <Button
                android:padding="0dp"
                android:id="@+id/income"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_secondary_button"
                app:backgroundTint="@null"
                android:text="Income"
                android:layout_marginEnd="@dimen/_7sdp"
                android:textColor="@color/button_text"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"/>

            <Button
                android:padding="0dp"
                android:id="@+id/Expense"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_secondary_button"
                app:backgroundTint="@null"
                android:text="Expense"
                android:layout_marginEnd="@dimen/_7sdp"
                android:textColor="@color/button_text"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"/>

            <Button
                android:padding="0dp"
                android:id="@+id/States"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_secondary_button"
                app:backgroundTint="@null"
                android:text="States"
                android:textColor="@color/button_text"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"/>

        </LinearLayout>

    <Button
        android:id="@+id/AddTransaction"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginVertical="@dimen/_10sdp"
        android:background="@drawable/bg_add_button"
        app:backgroundTint="@null"
        android:text="+ Add Transaction"
        android:textColor="@color/button_text"
        android:textSize="@dimen/_15sdp"
        android:textStyle="bold"/>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTransactions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp"/>

    </LinearLayout>
