<?xml version="1.0" encoding="utf-8"?>
<!-- Screen background: solid base + soft brand glow at the top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/main_background"/>
        </shape>
    </item>
    <item
        android:width="520dp"
        android:height="520dp"
        android:gravity="top|center_horizontal"
        android:top="-260dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="@color/glow_start"
                android:endColor="@color/glow_end"/>
        </shape>
    </item>
</layer-list>